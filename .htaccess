# ==============================================================================
# Instalgas Chile - Configuración Apache (.htaccess)
# ==============================================================================

# 1. Reescritura de URLs Limpias (Sin extensión .php)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirección 301 canónica: eliminar .php de la barra de direcciones si se solicita directamente
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.*?)\.php[\s?] [NC]
  RewriteRule ^ %1 [R=301,L]

  # Redirecciones 301 de URLs del sitio WordPress anterior para preservar SEO y enlaces
  RewriteRule ^gasfiter-certificado-sec/?$ /certificacion-sec [R=301,L]
  RewriteRule ^certificacion-sec-de-gas/?$ /certificacion-sec [R=301,L]
  RewriteRule ^instalacion-de-gas-santiago/?$ /servicios#redes [R=301,NE,L]
  RewriteRule ^deteccion-de-fugas-de-gas/?$ /deteccion-fugas-gas [R=301,L]
  RewriteRule ^sellado-de-fugas-de-gas/?$ /servicios#prodoral [R=301,NE,L]
  RewriteRule ^contacto-gasfiter-a-domicilio/?$ /contacto [R=301,L]

  # Quitar barra diagonal final si no es un directorio real
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} (.+)/$
  RewriteRule ^ %1 [R=301,L]

  # Servir internamente el archivo .php si existe
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.php -f
  RewriteRule ^(.*)$ $1.php [NC,L]

  # Archivos de IA y directos
  RewriteRule ^llms\.txt$ llms.txt [L]
  RewriteRule ^llms-full\.txt$ llms-full.txt [L]
  RewriteRule ^sitemap\.xml$ sitemap.xml [L]
  RewriteRule ^robots\.txt$ robots.txt [L]
</IfModule>

# 2. Codificación por Defecto UTF-8
AddDefaultCharset UTF-8

# 3. Compresión Gzip / Deflate para Máxima Velocidad (SEO Performance)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# 4. Caché de Navegador (Optimización Core Web Vitals)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>

# 5. Cabeceras de Seguridad y Protección
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
